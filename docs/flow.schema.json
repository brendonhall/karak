    "node_rare_phase": {
      "title": "Rare phases",
      "description": "Recluster still-unassigned pixels with more sensitive HDBSCAN parameters; novel clusters join the phase registry. Presence of this stage in a flow is what enables the two-pass workflow. Pixels of tiles that pass 1 deferred are left to noise_assign.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "rare_phase"
        },
        "params": {
          "$ref": "#/$defs/params_rare_phase"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_rare_phase": {
      "type": "object",
      "required": [
        "min_cluster_size",
        "min_samples",
        "subsample_n",
        "merge_threshold",
        "random_state",
        "device",
        "accumulate"
      ],
      "properties": {
        "min_cluster_size": {
          "type": "integer",
          "title": "Min cluster size",
          "description": "[px]",
          "minimum": 1,
          "default": 50
        },
        "min_samples": {
          "type": "integer",
          "title": "Min samples",
          "description": "0 = defaults to min_cluster_size",
          "minimum": 0,
          "default": 0
        },
        "subsample_n": {
          "type": "integer",
          "title": "Subsample N",
          "description": "Max unassigned pixels to fit on; 0 = all",
          "minimum": 0,
          "default": 500000
        },
        "merge_threshold": {
          "type": "number",
          "title": "Merge threshold",
          "description": "Cosine similarity a rare cluster needs to join an existing registry phase; usually the tiled node's merge_threshold",
          "minimum": 0.5,
          "maximum": 1.0,
          "default": 0.92
        },
        "random_state": {
          "type": "integer",
          "title": "Random seed",
          "default": 42
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu (hdbscan package) or cuda (cuML; needs karak[cuda]) for the pass-2 HDBSCAN; cuda labels agree with cpu but are not identical. Fingerprints and the registry merge run on the host.",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        },
        "accumulate": {
          "type": "string",
          "title": "Accumulate",
          "description": "Precision of the rare-cluster fingerprint sums: float64 is accurate; float32 reproduces the published baseline",
          "enum": [
            "float64",
            "float32"
          ],
          "default": "float64"
        }
      },
      "additionalProperties": false
    },
    "node_refine": {
      "title": "Phase refinement",
      "description": "Split a composite phase: threshold-based olivine extraction, then a GMM split of the remaining target-phase pixels.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "refine"
        },
        "params": {
          "$ref": "#/$defs/params_refine"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_refine": {
      "type": "object",
      "required": [
        "target_phase",
        "olivine_enabled",
        "olivine_fe_threshold",
        "olivine_ca_threshold",
        "gmm_enabled",
        "gmm_n_components",
        "gmm_features",
        "gmm_bse_weight",
        "gmm_subsample_n",
        "random_state"
      ],
      "properties": {
        "target_phase": {
          "type": "integer",
          "title": "Target phase",
          "description": "Cluster label of the phase to refine",
          "default": 2
        },
        "olivine_enabled": {
          "type": "boolean",
          "title": "Olivine extraction",
          "default": false
        },
        "olivine_fe_threshold": {
          "type": "number",
          "title": "Olivine Fe threshold",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.6
        },
        "olivine_ca_threshold": {
          "type": "number",
          "title": "Olivine Ca threshold",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.1
        },
        "gmm_enabled": {
          "type": "boolean",
          "title": "GMM split",
          "default": false
        },
        "gmm_n_components": {
          "type": "integer",
          "title": "GMM components",
          "minimum": 2,
          "default": 2
        },
        "gmm_features": {
          "type": "string",
          "title": "GMM features",
          "description": "Comma-separated channel names; 'BSE' adds backscatter",
          "default": "Ca,Mg,Fe-K,BSE"
        },
        "gmm_bse_weight": {
          "type": "number",
          "title": "BSE weight",
          "minimum": 0.0,
          "default": 1.0
        },
        "gmm_subsample_n": {
          "type": "integer",
          "title": "GMM subsample N",
          "description": "Max pixels to fit GMM on; 0 = all",
          "minimum": 0,
          "default": 500000
        },
        "random_state": {
          "type": "integer",
          "title": "Random seed",
          "default": 42
        }
      },
      "additionalProperties": false
    },
    "node_split_gmm": {
      "title": "Split by GMM",
      "description": "Split one phase with a Gaussian mixture on z-scored features (denoised channels, BSE, or a ratio A/(A+B)). The largest component can keep the parent label; new labels are named in order.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "split_gmm"
        },
        "params": {
          "$ref": "#/$defs/params_split_gmm"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_split_gmm": {
      "type": "object",
      "required": [
        "target_phase",
        "features",
        "n_components",
        "bse_weight",
        "subsample_n",
        "random_state",
        "keep_parent",
        "order_by",
        "new_names",
        "note"
      ],
      "properties": {
        "target_phase": {
          "type": "integer",
          "title": "Target phase",
          "description": "Label to split",
          "minimum": 0,
          "default": 0
        },
        "features": {
          "type": "string",
          "title": "Features",
          "description": "Comma list of channel names, 'BSE', or ratios 'A/(A+B)'",
          "default": ""
        },
        "n_components": {
          "type": "integer",
          "title": "Components",
          "minimum": 2,
          "default": 2
        },
        "bse_weight": {
          "type": "number",
          "title": "BSE weight",
          "description": "Multiplier on the z-scored BSE column",
          "minimum": 0.0,
          "default": 1.0
        },
        "subsample_n": {
          "type": "integer",
          "title": "Subsample N",
          "description": "Max pixels fitted; 0 = all",
          "minimum": 0,
          "default": 500000
        },
        "random_state": {
          "type": "integer",
          "title": "Random seed",
          "default": 42
        },
        "keep_parent": {
          "type": "boolean",
          "title": "Keep parent",
          "description": "The largest component keeps the parent label",
          "default": true
        },
        "order_by": {
          "type": "string",
          "title": "Order by",
          "description": "Feature whose component means (ascending) order the new labels; empty = by size, descending",
          "default": ""
        },
        "new_names": {
          "type": "string",
          "title": "New names",
          "description": "Comma list, one per new label, in order",
          "default": ""
        },
        "note": {
          "type": "string",
          "title": "Note",
          "description": "Why this split: the observation it rests on",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "node_split_threshold": {
      "title": "Split by threshold",
      "description": "Move the pixels of one phase that satisfy a rule on denoised channel values to a new label (e.g. olivine out of a pyroxene phase with 'Fe-K > 0.6 & Ca < 0.10').",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "split_threshold"
        },
        "params": {
          "$ref": "#/$defs/params_split_threshold"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_split_threshold": {
      "type": "object",
      "required": [
        "target_phase",
        "rule",
        "new_name",
        "note"
      ],
      "properties": {
        "target_phase": {
          "type": "integer",
          "title": "Target phase",
          "description": "Label to split",
          "minimum": 0,
          "default": 0
        },
        "rule": {
          "type": "string",
          "title": "Rule",
          "description": "Comparisons joined by '&': 'Fe-K > 0.6 & Ca < 0.10' (operators <, <=, >, >= on channel names)",
          "default": ""
        },
        "new_name": {
          "type": "string",
          "title": "New name",
          "description": "Name of the new label",
          "default": ""
        },
        "note": {
          "type": "string",
          "title": "Note",
          "description": "Why this split: the observation it rests on",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  }
