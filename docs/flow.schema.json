{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "karak flow",
  "description": "A karak pipeline (flow format version 2): stage nodes with every parameter listed, connected by edges from output ports to input ports. Generated from the stage registry.",
  "type": "object",
  "required": [
    "version",
    "name",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/endpoint",
          "description": "an output port"
        },
        "to": {
          "$ref": "#/$defs/endpoint",
          "description": "an input port"
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "description": "Editor-only metadata (e.g. canvas position); ignored when the flow runs."
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/node_cluster_stats"
        },
        {
          "$ref": "#/$defs/node_denoise"
        },
        {
          "$ref": "#/$defs/node_export_h5"
        },
        {
          "$ref": "#/$defs/node_fingerprints"
        },
        {
          "$ref": "#/$defs/node_hdbscan_global"
        },
        {
          "$ref": "#/$defs/node_hdbscan_tiled"
        },
        {
          "$ref": "#/$defs/node_load_elements"
        },
        {
          "$ref": "#/$defs/node_mask"
        },
        {
          "$ref": "#/$defs/node_name_phases"
        },
        {
          "$ref": "#/$defs/node_noise_assign"
        },
        {
          "$ref": "#/$defs/node_normalize"
        },
        {
          "$ref": "#/$defs/node_pca"
        },
        {
          "$ref": "#/$defs/node_qc_cluster_summary"
        },
        {
          "$ref": "#/$defs/node_qc_denoise"
        },
        {
          "$ref": "#/$defs/node_qc_fingerprints"
        },
        {
          "$ref": "#/$defs/node_qc_mask"
        },
        {
          "$ref": "#/$defs/node_qc_named_phase_map"
        },
        {
          "$ref": "#/$defs/node_qc_normalize"
        },
        {
          "$ref": "#/$defs/node_qc_phase_map"
        },
        {
          "$ref": "#/$defs/node_qc_scree"
        },
        {
          "$ref": "#/$defs/node_qc_tiled"
        },
        {
          "$ref": "#/$defs/node_rare_phase"
        },
        {
          "$ref": "#/$defs/node_refine"
        },
        {
          "$ref": "#/$defs/node_split_gmm"
        },
        {
          "$ref": "#/$defs/node_split_threshold"
        }
      ]
    },
    "node_cluster_stats": {
      "title": "Cluster statistics",
      "description": "Cluster counts, sizes, and noise fraction for the labels.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "cluster_stats"
        },
        "params": {
          "$ref": "#/$defs/params_cluster_stats"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_cluster_stats": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": false
    },
    "node_denoise": {
      "title": "Denoise",
      "description": "Edge-aware denoising (bilateral, symmetric or joint bilateral, or Perona-Malik anisotropic diffusion) applied per channel on raw intensities.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "denoise"
        },
        "params": {
          "$ref": "#/$defs/params_denoise"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_denoise": {
      "type": "object",
      "required": [
        "method",
        "sigma_color",
        "sigma_spatial",
        "niter",
        "kappa",
        "gamma",
        "option",
        "device"
      ],
      "properties": {
        "method": {
          "type": "string",
          "title": "Method",
          "description": "bilateral = scikit-image's filter (the published baseline, off-centre spatial table); bilateral_sym = symmetric kernel; joint_bilateral_total / joint_bilateral_bse = range weight from the summed channels / the BSE image (bse port)",
          "enum": [
            "bilateral",
            "bilateral_sym",
            "joint_bilateral_total",
            "joint_bilateral_bse",
            "anisotropic_diffusion"
          ],
          "default": "bilateral"
        },
        "sigma_color": {
          "type": [
            "number",
            "null"
          ],
          "title": "Color sigma",
          "description": "Bilateral range sigma (None = std of the channel, or of the guide for the joint methods)",
          "minimum": 0.0,
          "default": null
        },
        "sigma_spatial": {
          "type": "number",
          "title": "Spatial sigma",
          "minimum": 0.0,
          "default": 1.0
        },
        "niter": {
          "type": "integer",
          "title": "Iterations",
          "minimum": 1,
          "default": 10
        },
        "kappa": {
          "type": "number",
          "title": "Kappa",
          "description": "Conductance coefficient for diffusion",
          "minimum": 0.0,
          "default": 50.0
        },
        "gamma": {
          "type": "number",
          "title": "Gamma",
          "description": "Diffusion speed (0-0.25 stable)",
          "minimum": 0.0,
          "maximum": 0.25,
          "default": 0.1
        },
        "option": {
          "type": "integer",
          "title": "Perona-Malik option",
          "enum": [
            1,
            2
          ],
          "default": 2
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu or cuda (bilateral methods on the GPU via karak's CuPy kernel; needs karak[cuda]). Results match cpu within 1e-5.",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        }
      },
      "additionalProperties": false
    },
    "node_export_h5": {
      "title": "Export HDF5",
      "description": "Write connected results to the provenance HDF5 file using the legacy group layout. Every input is optional; only connected groups are written.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "export_h5"
        },
        "params": {
          "$ref": "#/$defs/params_export_h5"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_export_h5": {
      "type": "object",
      "required": [
        "path",
        "flow_json",
        "compression"
      ],
      "properties": {
        "path": {
          "type": "string",
          "title": "Output path",
          "default": "{out}.h5"
        },
        "flow_json": {
          "type": "string",
          "title": "Flow definition",
          "description": "JSON of the executing flow, embedded for provenance",
          "default": "{flow}"
        },
        "compression": {
          "type": "string",
          "title": "Compression",
          "description": "gzip (level 4, readable by any HDF5 tool), lzf (faster, h5py and PyTables only) or none; the denoised and normalized cubes also use the shuffle filter",
          "enum": [
            "gzip",
            "lzf",
            "none"
          ],
          "default": "gzip"
        }
      },
      "additionalProperties": false
    },
    "node_fingerprints": {
      "title": "Chemical fingerprints",
      "description": "Per-cluster mean/std element intensities from the denoised cube, with cosine-similar cluster pairs flagged for review.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "fingerprints"
        },
        "params": {
          "$ref": "#/$defs/params_fingerprints"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_fingerprints": {
      "type": "object",
      "required": [
        "similarity_threshold",
        "accumulate"
      ],
      "properties": {
        "similarity_threshold": {
          "type": "number",
          "title": "Similarity threshold",
          "description": "Cosine similarity above which cluster pairs are flagged",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.95
        },
        "accumulate": {
          "type": "string",
          "title": "Accumulate",
          "description": "Precision of the mean/std sums: float64 is accurate; float32 reproduces the published baseline (drifts by a few percent on clusters of millions of pixels)",
          "enum": [
            "float64",
            "float32"
          ],
          "default": "float64"
        }
      },
      "additionalProperties": false
    },
    "node_hdbscan_global": {
      "title": "HDBSCAN (global)",
      "description": "Single HDBSCAN run over all mineral-pixel features.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "hdbscan_global"
        },
        "params": {
          "$ref": "#/$defs/params_hdbscan_global"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_hdbscan_global": {
      "type": "object",
      "required": [
        "min_cluster_size",
        "min_samples",
        "subsample_n",
        "random_state",
        "device"
      ],
      "properties": {
        "min_cluster_size": {
          "type": "integer",
          "title": "Min cluster size",
          "description": "[px]",
          "minimum": 1,
          "default": 1000
        },
        "min_samples": {
          "type": "integer",
          "title": "Min samples",
          "description": "HDBSCAN min_samples; 0 = defaults to min_cluster_size",
          "minimum": 0,
          "default": 0
        },
        "subsample_n": {
          "type": "integer",
          "title": "Subsample N",
          "description": "Max pixels for fitting (rest via approximate_predict); 0 = all",
          "minimum": 0,
          "default": 0
        },
        "random_state": {
          "type": "integer",
          "title": "Random seed",
          "default": 42
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu (hdbscan package, exact baseline) or cuda (cuML; needs karak[cuda]). cuda results differ from cpu; with subsample_n both fit the same subsample. On full tiles (hdbscan_tiled) cuda can select different clusters than cpu; use cpu to match it.",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        }
      },
      "additionalProperties": false
    },
    "node_hdbscan_tiled": {
      "title": "HDBSCAN (tiled)",
      "description": "Per-tile HDBSCAN with cosine-similarity phase-registry merging. Unassigned pixels are left at -1 for the noise_assign stage.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "hdbscan_tiled"
        },
        "params": {
          "$ref": "#/$defs/params_hdbscan_tiled"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_hdbscan_tiled": {
      "type": "object",
      "required": [
        "min_cluster_size",
        "min_samples",
        "subsample_n",
        "random_state",
        "device",
        "tile_size",
        "merge_threshold",
        "min_tile_pixels",
        "min_clusters_per_tile",
        "accumulate"
      ],
      "properties": {
        "min_cluster_size": {
          "type": "integer",
          "title": "Min cluster size",
          "description": "[px]",
          "minimum": 1,
          "default": 1000
        },
        "min_samples": {
          "type": "integer",
          "title": "Min samples",
          "description": "HDBSCAN min_samples; 0 = defaults to min_cluster_size",
          "minimum": 0,
          "default": 0
        },
        "subsample_n": {
          "type": "integer",
          "title": "Subsample N",
          "description": "Max pixels for fitting (rest via approximate_predict); 0 = all",
          "minimum": 0,
          "default": 0
        },
        "random_state": {
          "type": "integer",
          "title": "Random seed",
          "default": 42
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu (hdbscan package, exact baseline) or cuda (cuML; needs karak[cuda]). cuda results differ from cpu; with subsample_n both fit the same subsample. On full tiles (hdbscan_tiled) cuda can select different clusters than cpu; use cpu to match it.",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        },
        "tile_size": {
          "type": "integer",
          "title": "Tile size",
          "description": "[px]",
          "minimum": 1,
          "default": 512
        },
        "merge_threshold": {
          "type": "number",
          "title": "Merge threshold",
          "description": "Cosine similarity for matching tile clusters to the registry",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.92
        },
        "min_tile_pixels": {
          "type": "integer",
          "title": "Min tile pixels",
          "description": "Minimum mineral pixels per tile; 0 = 2 * min_cluster_size",
          "minimum": 0,
          "default": 0
        },
        "min_clusters_per_tile": {
          "type": "integer",
          "title": "Min clusters per tile",
          "description": "Tiles with fewer clusters defer to the k-NN pass",
          "minimum": 0,
          "default": 3
        },
        "accumulate": {
          "type": "string",
          "title": "Accumulate",
          "description": "Precision of the tile-fingerprint sums: float64 is accurate; float32 reproduces the published baseline",
          "enum": [
            "float64",
            "float32"
          ],
          "default": "float64"
        }
      },
      "additionalProperties": false
    },
    "node_load_elements": {
      "title": "Load element maps",
      "description": "Load false-color element map images, invert the colormap to scalar [0, 1] intensities, downsample/trim, and stack into a cube.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "load_elements"
        },
        "params": {
          "$ref": "#/$defs/params_load_elements"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_load_elements": {
      "type": "object",
      "required": [
        "input_dir",
        "file_glob",
        "filename_pattern",
        "bse_filename",
        "colormap",
        "exclude_elements",
        "include_elements",
        "bse_channel",
        "header_trim_px",
        "bottom_trim_px",
        "left_trim_px",
        "right_trim_px",
        "downsample_factor"
      ],
      "properties": {
        "input_dir": {
          "type": "string",
          "title": "Input directory",
          "description": "Directory containing element map files",
          "default": "{input}"
        },
        "file_glob": {
          "type": "string",
          "title": "File glob",
          "description": "Glob pattern (relative to input_dir) for element map files",
          "default": "*.png"
        },
        "filename_pattern": {
          "type": [
            "string",
            "null"
          ],
          "title": "Filename pattern",
          "description": "Pattern with {element} placeholder; None = legacy TIMA heuristic",
          "default": null
        },
        "bse_filename": {
          "type": [
            "string",
            "null"
          ],
          "title": "BSE filename",
          "description": "Exact BSE file name when it does not match the glob",
          "default": null
        },
        "colormap": {
          "type": "string",
          "title": "Colormap",
          "description": "'tima:jet', 'cmap:NAME' or 'lut:PATH' inversion spec",
          "default": "tima:jet"
        },
        "exclude_elements": {
          "type": "string",
          "title": "Exclude elements",
          "description": "Comma-separated element names to skip",
          "default": "Fe-L"
        },
        "include_elements": {
          "type": [
            "string",
            "null"
          ],
          "title": "Include elements",
          "description": "Comma-separated allowlist; None = load all",
          "default": null
        },
        "bse_channel": {
          "type": "string",
          "title": "BSE channel",
          "description": "Element name of the BSE/SEM channel",
          "default": "SEM"
        },
        "header_trim_px": {
          "type": "integer",
          "title": "Header trim",
          "description": "[px]",
          "minimum": 0,
          "default": 0
        },
        "bottom_trim_px": {
          "type": "integer",
          "title": "Bottom trim",
          "description": "[px]",
          "minimum": 0,
          "default": 0
        },
        "left_trim_px": {
          "type": "integer",
          "title": "Left trim",
          "description": "[px]",
          "minimum": 0,
          "default": 0
        },
        "right_trim_px": {
          "type": "integer",
          "title": "Right trim",
          "description": "[px]",
          "minimum": 0,
          "default": 0
        },
        "downsample_factor": {
          "type": "integer",
          "title": "Downsample factor",
          "minimum": 1,
          "default": 2
        }
      },
      "additionalProperties": false
    },
    "node_mask": {
      "title": "Mineral mask",
      "description": "Boolean mineral-pixel mask: all-zero pixels are background; an optional napari polygon CSV restricts the valid sample region.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "mask"
        },
        "params": {
          "$ref": "#/$defs/params_mask"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_mask": {
      "type": "object",
      "required": [
        "min_object_size",
        "valid_mask_path"
      ],
      "properties": {
        "min_object_size": {
          "type": "integer",
          "title": "Min object size",
          "description": "Remove connected components smaller than this [px]",
          "minimum": 0,
          "default": 100
        },
        "valid_mask_path": {
          "type": [
            "string",
            "null"
          ],
          "title": "Valid-region CSV",
          "description": "napari shapes CSV of the sample boundary polygon (coordinates in original, pre-downsample image space)",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "node_name_phases": {
      "title": "Name phases",
      "description": "Attach mineral names to phase labels. Names travel with the labels to the split stages, the fingerprints, the QC figures and the HDF5 export (clusters/mineral_names).",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "name_phases"
        },
        "params": {
          "$ref": "#/$defs/params_name_phases"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_name_phases": {
      "type": "object",
      "required": [
        "names",
        "note"
      ],
      "properties": {
        "names": {
          "type": "string",
          "title": "Names",
          "description": "Entries 'label: name' separated by ';', e.g. '0: Ilmenite (FeTiO\u2083); 1: Silica polymorph (SiO\u2082)'",
          "default": ""
        },
        "note": {
          "type": "string",
          "title": "Note",
          "description": "How the names were decided (fingerprints, TIMA, references)",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "node_noise_assign": {
      "title": "Noise reassignment",
      "description": "Assign every remaining -1 pixel to its nearest phase by distance-weighted k-NN voting in feature space.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "noise_assign"
        },
        "params": {
          "$ref": "#/$defs/params_noise_assign"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_noise_assign": {
      "type": "object",
      "required": [
        "k",
        "device"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "title": "Neighbors",
          "minimum": 1,
          "default": 5
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu (sklearn KD-tree) or cuda (CuPy brute-force search, same vote; labels match cpu unless distances tie within float32; needs karak[cuda])",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        }
      },
      "additionalProperties": false
    },
    "node_normalize": {
      "title": "Normalize",
      "description": "Per-channel z-score normalization over mineral pixels; non-mineral pixels are set to 0.",
      "type": "object",
      "required": [
        "id",
        "type",
        "params"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "normalize"
        },
        "params": {
          "$ref": "#/$defs/params_normalize"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "additionalProperties": false
    },
    "params_normalize": {
      "type": "object",
      "required": [
        "method",
        "accumulate",
        "device"
      ],
      "properties": {
        "method": {
          "type": "string",
          "title": "Method",
          "enum": [
            "zscore"
          ],
          "default": "zscore"
        },
        "accumulate": {
          "type": "string",
          "title": "Accumulate",
          "description": "Precision of the mean/std sums: float64 is accurate; float32 reproduces the published NWA 4587 baseline (std up to 3.6 % off on 12.5 M pixels)",
          "enum": [
            "float64",
            "float32"
          ],
          "default": "float64"
        },
        "device": {
          "type": "string",
          "title": "Device",
          "description": "cpu or cuda (the executor moves the inputs; needs karak[cuda])",
          "enum": [
            "cpu",
            "cuda"
          ],
          "default": "cpu"
        }
      },
      "additionalProperties": false
    },
    "node_pca": {
      "title": "PCA",
      "description": "Fit PCA on mineral pixels of the normalized cube and project them into reduced feature space. n_components=0 auto-selects the first component count reaching the cumulative-variance threshold.",
