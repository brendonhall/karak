{
  "version": 2,
  "name": "global",
  "nodes": [
    {
      "id": "src",
      "type": "load_elements",
      "params": {
        "input_dir": "{input}",
        "file_glob": "*.png",
        "filename_pattern": null,
        "bse_filename": null,
        "colormap": "tima:jet",
        "exclude_elements": "Fe-L",
        "include_elements": null,
        "bse_channel": "SEM",
        "header_trim_px": 0,
        "bottom_trim_px": 0,
        "left_trim_px": 0,
        "right_trim_px": 0,
        "downsample_factor": 2
      }
    },
    {
      "id": "msk",
      "type": "mask",
      "params": {
        "min_object_size": 100,
        "valid_mask_path": null
      }
    },
    {
      "id": "dn",
      "type": "denoise",
      "params": {
        "method": "bilateral",
        "sigma_color": null,
        "sigma_spatial": 1.0,
        "niter": 10,
        "kappa": 50.0,
        "gamma": 0.1,
        "option": 2,
        "device": "cpu"
      }
    },
    {
      "id": "nrm",
      "type": "normalize",
      "params": {
        "method": "zscore",
        "accumulate": "float64",
        "device": "cpu"
      }
    },
    {
      "id": "pca",
      "type": "pca",
      "params": {
        "n_components": 0,
        "variance_threshold": 0.95,
        "min_components": 5,
        "subsample_fraction": 0.0,
        "random_state": 42,
        "device": "cpu"
      }
    },
    {
      "id": "hdb",
      "type": "hdbscan_global",
      "params": {
        "min_cluster_size": 1000,
        "min_samples": 0,
        "subsample_n": 0,
        "random_state": 42,
        "device": "cpu"
      }
    },
    {
      "id": "knn",
      "type": "noise_assign",
      "params": {
        "k": 5
      }
    },
    {
      "id": "stats",
      "type": "cluster_stats",
      "params": {}
    },
    {
      "id": "fp",
      "type": "fingerprints",
      "params": {
        "similarity_threshold": 0.95
      }
    },
    {
      "id": "exp",
      "type": "export_h5",
      "params": {
        "path": "{out}.h5",
        "flow_json": "{flow}"
      }
    },
    {
      "id": "qc_mask",
      "type": "qc_mask",
      "params": {
        "figure_dir": "{out}/figures",
        "tima_path": null
      }
    },
    {
      "id": "qc_denoise",
      "type": "qc_denoise",
      "params": {
        "figure_dir": "{out}/figures",
        "method": "bilateral"
      }
    },
    {
      "id": "qc_normalize",
      "type": "qc_normalize",
      "params": {
        "figure_dir": "{out}/figures"
      }
    },
    {
      "id": "qc_scree",
      "type": "qc_scree",
      "params": {
        "figure_dir": "{out}/figures"
      }
    },
    {
      "id": "qc_phase_map",
      "type": "qc_phase_map",
      "params": {
        "figure_dir": "{out}/figures"
      }
    },
    {
      "id": "qc_cluster_summary",
      "type": "qc_cluster_summary",
      "params": {
        "figure_dir": "{out}/figures"
      }
    },
    {
      "id": "qc_fingerprints",
      "type": "qc_fingerprints",
      "params": {
        "figure_dir": "{out}/figures",
        "mineral_names": null
      }
    }
  ],
