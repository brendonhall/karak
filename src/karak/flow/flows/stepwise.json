{
  "version": 2,
  "name": "stepwise",
  "nodes": [
    {
      "id": "src",
      "type": "load_elements",
      "params": {
        "input_dir": "{input}",
        "file_glob": "*.png",
        "filename_pattern": null,
        "bse_filename": null,
        "colormap": "tima:jet",
        "exclude_elements": "Fe-L",
        "include_elements": null,
        "bse_channel": "SEM",
        "header_trim_px": 0,
        "bottom_trim_px": 0,
        "left_trim_px": 0,
        "right_trim_px": 0,
        "downsample_factor": 2
      }
    },
    {
      "id": "msk",
      "type": "mask",
      "params": {
        "min_object_size": 100,
        "valid_mask_path": null
      }
    },
    {
      "id": "dn",
      "type": "denoise",
      "params": {
        "method": "bilateral",
        "sigma_color": null,
        "sigma_spatial": 1.0,
        "niter": 10,
        "kappa": 50.0,
        "gamma": 0.1,
        "option": 2,
        "device": "cpu"
      }
    },
    {
      "id": "nrm",
      "type": "normalize",
      "params": {
        "method": "zscore",
        "accumulate": "float64",
        "device": "cpu"
      }
    },
    {
      "id": "pca",
      "type": "pca",
      "params": {
        "n_components": 0,
        "variance_threshold": 0.95,
        "min_components": 5,
        "subsample_fraction": 0.0,
        "random_state": 42,
        "device": "cpu"
      }
    },
    {
      "id": "hdb",
      "type": "hdbscan_global",
      "params": {
        "min_cluster_size": 1000,
        "min_samples": 0,
        "subsample_n": 0,
        "random_state": 42,
        "device": "cpu"
      }
    },
    {
      "id": "knn",
      "type": "noise_assign",
      "params": {
        "k": 5,
        "device": "cpu"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "src",
        "port": "cube"
      },
      "to": {
        "node": "msk",
        "port": "cube"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "src",
        "port": "cube"
      },
      "to": {
        "node": "dn",
        "port": "cube"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "msk",
        "port": "masks"
      },
      "to": {
        "node": "dn",
        "port": "masks"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "dn",
        "port": "cube"
      },
      "to": {
        "node": "nrm",
        "port": "cube"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "msk",
        "port": "masks"
      },
      "to": {
        "node": "nrm",
        "port": "masks"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "nrm",
        "port": "cube"
      },
      "to": {
        "node": "pca",
        "port": "cube"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "msk",
        "port": "masks"
      },
      "to": {
        "node": "pca",
        "port": "masks"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "pca",
        "port": "features"
      },
      "to": {
        "node": "hdb",
        "port": "features"
      }
    },
    {
      "id": "e9",
      "from": {
        "node": "hdb",
        "port": "labels"
      },
      "to": {
        "node": "knn",
        "port": "labels"
      }
    },
    {
      "id": "e10",
      "from": {
        "node": "pca",
        "port": "features"
      },
      "to": {
        "node": "knn",
        "port": "features"
      }
    }
  ]
}
